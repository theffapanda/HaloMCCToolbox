<Window x:Class="HaloToolbox.GameNetworkStatsOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Width="760"
        Height="132"
        MinWidth="520"
        MinHeight="112"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border x:Name="OverlayRoot"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="1"
            CornerRadius="3"
            IsHitTestVisible="False">
        <Grid>
            <wv2:WebView2 x:Name="OverlayBrowser"
                          DefaultBackgroundColor="Transparent"/>

            <Border x:Name="DragSurface"
                    Background="Transparent"
                    Panel.ZIndex="5"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown"/>

            <primitives:Thumb x:Name="ResizeThumb"
                              Width="42"
                              Height="42"
                              Panel.ZIndex="10"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Cursor="SizeNWSE"
                              Visibility="Collapsed"
                              DragStarted="ResizeThumb_DragStarted"
                              DragDelta="ResizeThumb_DragDelta"
                              DragCompleted="ResizeThumb_DragCompleted">
                <primitives:Thumb.Template>
                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                        <Grid Background="#01000000">
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Width="22"
                                    Height="22"
                                    Background="#2200C8FF"
                                    BorderBrush="#6600C8FF"
                                    BorderThickness="1"
                                    CornerRadius="2"/>
                            <Path Data="M 24 36 L 36 24 M 29 36 L 36 29 M 34 36 L 36 34"
                                  Stroke="#AA00C8FF"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Grid>
                    </ControlTemplate>
                </primitives:Thumb.Template>
            </primitives:Thumb>
        </Grid>
    </Border>
</Window>

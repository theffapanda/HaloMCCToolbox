<Window x:Class="HaloToolbox.GameNetworkStatsOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Width="1280"
        Height="170"
        MinWidth="520"
        MinHeight="132"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="OverlayLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8EA4B8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="OverlayValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E7F5FF"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="OverlayEditToggle" TargetType="{x:Type primitives:ToggleButton}">
            <Setter Property="Foreground" Value="#8EA4B8"/>
            <Setter Property="Background" Value="#CC101A24"/>
            <Setter Property="BorderBrush" Value="#66506A7E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:ToggleButton}">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#CC06384A"/>
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#00C8FF"/>
                                <Setter Property="Foreground" Value="#E7F5FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#00C8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverlayCard" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>

    <Border x:Name="OverlayRoot"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="1"
            CornerRadius="3"
            IsHitTestVisible="False">
        <Grid>
            <Border x:Name="NetworkPanel" Style="{StaticResource OverlayCard}">
                <Grid>
                <Viewbox x:Name="NetworkClassicLayout"
                         Stretch="Uniform"
                         StretchDirection="Both"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch">
                    <Grid Width="392" Height="108">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="31"/>
                            <RowDefinition Height="17"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="29"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Text="NETWORK"
                                       Foreground="#00C8FF"
                                       FontFamily="Consolas"
                                       FontWeight="Bold"
                                       FontSize="13"/>
                            <TextBlock x:Name="NetworkServerText"
                                       Text="SERVER: --"
                                       Style="{StaticResource OverlayLabel}"
                                       FontSize="13"
                                       TextAlignment="Right"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <TextBlock x:Name="NetworkPingText"
                                       Foreground="#39FF14"
                                       FontFamily="Consolas"
                                       FontWeight="Bold"
                                       FontSize="26"
                                       VerticalAlignment="Center"/>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="NetworkLossText"
                                           Style="{StaticResource OverlayValue}"
                                           FontSize="21"
                                           TextAlignment="Right"/>
                                <TextBlock x:Name="NetworkJitterText"
                                           Foreground="#39FF14"
                                           FontFamily="Consolas"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="UP" Foreground="#39FF14" FontFamily="Consolas" FontWeight="Bold" FontSize="13"/>
                                <TextBlock x:Name="NetworkUpText" Style="{StaticResource OverlayValue}" FontSize="13" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="DOWN" Foreground="#00C8FF" FontFamily="Consolas" FontWeight="Bold" FontSize="13"/>
                                <TextBlock x:Name="NetworkDownText" Style="{StaticResource OverlayValue}" FontSize="13" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="3">
                            <TextBlock x:Name="NetworkUpPacketsText" Style="{StaticResource OverlayLabel}" FontSize="12"/>
                            <TextBlock x:Name="NetworkDownPacketsText"
                                       Style="{StaticResource OverlayLabel}"
                                       FontSize="12"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Canvas Grid.Row="4"
                                Width="352"
                                Height="29"
                                HorizontalAlignment="Center">
                            <Line X1="0" Y1="8" X2="352" Y2="8" Stroke="#2400C8FF" StrokeThickness="1"/>
                            <Line X1="0" Y1="21" X2="352" Y2="21" Stroke="#2400C8FF" StrokeThickness="1"/>
                            <Polyline x:Name="NetworkGraphGlow"
                                      Stroke="#5200C8FF"
                                      StrokeThickness="6"
                                      StrokeLineJoin="Round"/>
                            <Polyline x:Name="NetworkGraphLine"
                                      Stroke="#39FF14"
                                      StrokeThickness="2.4"
                                      StrokeLineJoin="Round"/>
                        </Canvas>
                    </Grid>
                </Viewbox>
                <Grid x:Name="NetworkModernLayout" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock x:Name="NetworkModernServerText"
                                   Text="SERVER: --"
                                   Foreground="#00C8FF"
                                   FontFamily="Consolas"
                                   FontWeight="Bold"
                                   FontSize="13"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="NetworkModernPingText" Style="{StaticResource OverlayValue}" Margin="16,0,0,0"/>
                            <TextBlock x:Name="NetworkModernJitterText" Style="{StaticResource OverlayValue}" Margin="16,0,0,0"/>
                            <TextBlock x:Name="NetworkModernLossText" Style="{StaticResource OverlayValue}" Margin="16,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="NetworkModernUpText" Style="{StaticResource OverlayLabel}"/>
                            <TextBlock x:Name="NetworkModernDownText" Style="{StaticResource OverlayLabel}" Margin="0,7,0,0"/>
                        </StackPanel>
                        <Viewbox Grid.Column="1" Stretch="Fill" Margin="10,0,0,0">
                            <Canvas Width="240" Height="54">
                                <Polyline x:Name="NetworkModernGraphGlow"
                                          Stroke="#5500C8FF"
                                          StrokeThickness="5"
                                          StrokeLineJoin="Round"/>
                                <Polyline x:Name="NetworkModernGraphLine"
                                          Stroke="#00C8FF"
                                          StrokeThickness="1.6"
                                          StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Grid>
                </Grid>
            </Border>

            <Border x:Name="WaitPanel" Style="{StaticResource OverlayCard}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="WaitValueText"
                               Text="EST. WAIT --"
                               Foreground="#00C8FF"
                               FontFamily="Consolas"
                               FontWeight="Bold"
                               FontSize="21"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="WaitDetailText"
                               Style="{StaticResource OverlayLabel}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border x:Name="SessionPanel" Style="{StaticResource OverlayCard}" Visibility="Collapsed">
                <Grid>
                <Viewbox x:Name="SessionClassicLayout"
                         Stretch="Uniform"
                         StretchDirection="Both"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch">
                    <Grid Width="840" Height="206">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="58"/>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="90"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Text="SESSION" Style="{StaticResource OverlayLabel}" FontWeight="Bold"/>
                            <TextBlock x:Name="SessionGamesText"
                                       Style="{StaticResource OverlayLabel}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="SessionWinsText"
                                           Foreground="#39FF14"
                                           FontFamily="Consolas"
                                           FontWeight="Bold"
                                           FontSize="30"/>
                                <TextBlock Text=" - "
                                           Foreground="#53636E"
                                           FontFamily="Consolas"
                                           FontWeight="Bold"
                                           FontSize="30"/>
                                <TextBlock x:Name="SessionLossesText"
                                           Foreground="#FF2D55"
                                           FontFamily="Consolas"
                                           FontWeight="Bold"
                                           FontSize="30"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="WIN RATE"
                                           Style="{StaticResource OverlayLabel}"
                                           FontSize="13"
                                           TextAlignment="Right"/>
                                <TextBlock x:Name="SessionWinRateText"
                                           Foreground="#00C8FF"
                                           FontFamily="Consolas"
                                           FontWeight="Bold"
                                           FontSize="26"
                                           TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="K/D" Style="{StaticResource OverlayLabel}" FontWeight="Bold"/>
                                    <TextBlock x:Name="SessionKdText"
                                               Style="{StaticResource OverlayValue}"
                                               FontSize="20"
                                               Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="SessionBestSpreeText"
                                           Style="{StaticResource OverlayLabel}"
                                           FontSize="9"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="SessionKillsText"
                                       Grid.Column="1"
                                       Foreground="#39FF14"
                                       FontFamily="Consolas"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="SessionDeathsText"
                                       Grid.Column="2"
                                       Foreground="#FF2D55"
                                       FontFamily="Consolas"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <primitives:UniformGrid x:Name="SessionMedalsPanel"
                                                Grid.Row="3"
                                                Rows="1"
                                                Columns="9"
                                                VerticalAlignment="Stretch"
                                                HorizontalAlignment="Stretch"/>
                    </Grid>
                </Viewbox>
                <Grid x:Name="SessionModernLayout" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="235"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="SESSION"
                                   Foreground="#00C8FF"
                                   FontFamily="Consolas"
                                   FontWeight="Bold"
                                   FontSize="13"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock x:Name="SessionModernWinsText" Style="{StaticResource OverlayValue}" FontSize="20"/>
                            <TextBlock x:Name="SessionModernLossesText" Style="{StaticResource OverlayValue}" FontSize="20" Margin="14,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="SessionModernGamesText" Style="{StaticResource OverlayLabel}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="SessionModernKdText" Style="{StaticResource OverlayValue}" FontSize="18" Margin="0,10,0,0"/>
                        <TextBlock x:Name="SessionModernKillsDeathsText" Style="{StaticResource OverlayLabel}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="SessionModernBestSpreeText" Style="{StaticResource OverlayLabel}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <primitives:UniformGrid x:Name="SessionModernMedalsPanel"
                                            Grid.Column="1"
                                            Rows="1"
                                            Columns="9"
                                            VerticalAlignment="Stretch"
                                            HorizontalAlignment="Stretch"/>
                </Grid>
                </Grid>
            </Border>

            <Border x:Name="RecapPanel"
                    Style="{StaticResource OverlayCard}"
                    BorderThickness="0"
                    Visibility="Collapsed">
                <Viewbox Stretch="Uniform"
                         StretchDirection="Both"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch">
                    <Grid Width="840" Height="150">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="104"/>
                            <RowDefinition Height="2"/>
                            <RowDefinition Height="16"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Text="POST-GAME RECAP"
                                       Foreground="#00C8FF"
                                       FontFamily="Consolas"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="RecapResultText"
                                       Foreground="#35E08D"
                                       FontFamily="Consolas"
                                       FontWeight="Bold"
                                       FontSize="22"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border BorderBrush="#5700C8FF"
                                    BorderThickness="1,0,0,0"
                                    Padding="12,0,10,0">
                                <StackPanel VerticalAlignment="Center">
                                    <Viewbox Stretch="Uniform"
                                             StretchDirection="DownOnly"
                                             HorizontalAlignment="Stretch">
                                        <TextBlock x:Name="RecapGameText"
                                                   Style="{StaticResource OverlayValue}"
                                                   FontSize="20"/>
                                    </Viewbox>
                                    <TextBlock x:Name="RecapGameKdText"
                                               Style="{StaticResource OverlayValue}"
                                               FontSize="20"
                                               Margin="0,1,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <TextBlock Text="SESSION K/D"
                                                   Style="{StaticResource OverlayLabel}"
                                                   FontSize="10"/>
                                        <TextBlock x:Name="RecapKdText"
                                                   Foreground="#00C8FF"
                                                   FontFamily="Consolas"
                                                   FontWeight="Bold"
                                                   FontSize="15"
                                                   Margin="10,-3,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="RecapBestText"
                                               Foreground="#39FF14"
                                               FontFamily="Consolas"
                                               FontSize="9"
                                               Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    BorderBrush="#5700C8FF"
                                    BorderThickness="1,0,0,0"
                                    Padding="12,0,10,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="66"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="RecapFeatureIcon"
                                           Width="66"
                                           Height="66"
                                           Stretch="Uniform"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="RecapFeatureText"
                                                   Foreground="#00C8FF"
                                                   FontFamily="Consolas"
                                                   FontWeight="Bold"
                                                   FontSize="15"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="RecapFeatureDetailText"
                                                   Style="{StaticResource OverlayLabel}"
                                                   FontSize="9"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    BorderBrush="#5700C8FF"
                                    BorderThickness="1,0,0,0"
                                    Padding="12,0,0,0">
                                <primitives:UniformGrid x:Name="RecapDeltaPanel"
                                                        Rows="2"
                                                        Columns="2"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Stretch"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2"
                              Background="#2E00C8FF"
                              ClipToBounds="True">
                            <Border x:Name="RecapProgress"
                                    Background="#00C8FF"
                                    RenderTransformOrigin="0,0">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="RecapProgressScale" ScaleX="1"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Grid>
                </Viewbox>
            </Border>

            <Border x:Name="EditToolbar"
                    Panel.ZIndex="20"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="6"
                    Padding="7,5"
                    Background="#EE081018"
                    BorderBrush="#CC00C8FF"
                    BorderThickness="1"
                    CornerRadius="3"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="EditToolbarLabel"
                               Text="MOVE / RESIZE"
                               Foreground="#00C8FF"
                               FontFamily="Consolas"
                               FontWeight="Bold"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <StackPanel x:Name="StyleOptionsPanel"
                                Orientation="Horizontal">
                        <TextBlock Text="STYLE"
                                   Foreground="#8EA4B8"
                                   FontFamily="Consolas"
                                   FontSize="9"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <primitives:ToggleButton x:Name="ClassicStyleButton"
                                                 Content="CLASSIC"
                                                 Style="{StaticResource OverlayEditToggle}"
                                                 Click="ClassicStyleButton_Click"/>
                        <primitives:ToggleButton x:Name="ModernStyleButton"
                                                 Content="MODERN"
                                                 Style="{StaticResource OverlayEditToggle}"
                                                 Margin="4,0,0,0"
                                                 Click="ModernStyleButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="DragSurface"
                    Background="#01000000"
                    Panel.ZIndex="5"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Cursor="SizeAll"
                    Visibility="Collapsed"
                    PreviewMouseLeftButtonDown="DragSurface_MouseLeftButtonDown"/>

            <primitives:Thumb x:Name="ResizeThumb"
                              Width="42"
                              Height="42"
                              Panel.ZIndex="10"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Cursor="SizeNWSE"
                              Visibility="Collapsed"
                              PreviewMouseLeftButtonDown="ResizeThumb_MouseLeftButtonDown">
                <primitives:Thumb.Template>
                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                        <Grid Background="#01000000">
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Width="22"
                                    Height="22"
                                    Background="#2200C8FF"
                                    BorderBrush="#6600C8FF"
                                    BorderThickness="1"
                                    CornerRadius="2"/>
                            <Path Data="M 24 36 L 36 24 M 29 36 L 36 29 M 34 36 L 36 34"
                                  Stroke="#AA00C8FF"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Grid>
                    </ControlTemplate>
                </primitives:Thumb.Template>
            </primitives:Thumb>
        </Grid>
    </Border>
</Window>

<Window x:Class="HaloToolbox.ToolboxDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560"
        MinWidth="440"
        MaxWidth="680"
        MaxHeight="720"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Consolas"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="DialogSecondaryButton" TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="MinWidth" Value="92"/>
        </Style>
        <Style x:Key="DialogPrimaryButton" TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="MinWidth" Value="112"/>
        </Style>
        <Style x:Key="DialogCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBackground"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBackground"
                                        Property="Background"
                                        Value="#CCFF2D55"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseBackground"
                                        Property="Background"
                                        Value="#FFFF2D55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="DialogFrame"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1"
            Background="{DynamicResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    Padding="18,12"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="DialogIconBorder"
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="2"
                            CornerRadius="15">
                        <TextBlock x:Name="DialogIconText"
                                   Text="i"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontFamily="Consolas"
                                   FontWeight="Bold"
                                   FontSize="19"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,-1,0,0"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="DialogTitleText"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="HALO MCC TOOLBOX"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="10"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="×"
                            Width="30"
                            Height="30"
                            Padding="0"
                            FontFamily="Consolas"
                            FontSize="23"
                            FontWeight="Normal"
                            Background="Transparent"
                            Foreground="{DynamicResource AccentBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Close"
                            Style="{StaticResource DialogCloseButton}"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Height="1"
                    Background="{DynamicResource AccentBrush}"/>

            <ScrollViewer Grid.Row="2"
                          MaxHeight="500"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Style="{StaticResource FlatScrollViewer}">
                <Grid Margin="38,30,38,26">
                    <TextBlock x:Name="DialogMessageText"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="13"
                               LineHeight="20"
                               TextWrapping="Wrap"/>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="3"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="18,12">
                <StackPanel x:Name="DialogButtons"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"/>
            </Border>
        </Grid>
    </Border>
</Window>

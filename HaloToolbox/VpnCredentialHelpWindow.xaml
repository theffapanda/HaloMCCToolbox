<Window x:Class="HaloToolbox.VpnCredentialHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NordVPN service credentials"
        Width="940" Height="700" MinWidth="680" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Consolas"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="FIND YOUR NORD SERVICE CREDENTIALS"
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="These are different from the email and password used to sign in to Nord Account."
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="3" Padding="12" Margin="0,0,0,14">
            <TextBlock FontSize="11" TextWrapping="Wrap">
                <Run Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Text="1. "/>
                <Run Text="Open the Nord page below and sign in.  "/>
                <Run Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Text="2. "/>
                <Run Text="Select Service credentials.  "/>
                <Run Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Text="3. "/>
                <Run Text="Copy the generated username and password into Toolbox."/>
            </TextBlock>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="4">
            <Image Source="/HaloMCCToolbox;component/Resources/Vpn/nord-service-credentials-guide.png"
                   Stretch="Uniform" SnapsToDevicePixels="True"
                   ToolTip="Nord Account → NordVPN → Manual setup → Service credentials"/>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                       FontSize="9" TextWrapping="Wrap"
                       Text="Toolbox never needs your normal Nord Account password."/>
            <Button Grid.Column="1" Content="OPEN NORD SERVICE CREDENTIALS"
                    Style="{StaticResource GreenButton}" Padding="14,7"
                    Click="OpenCredentials_Click"/>
            <Button Grid.Column="3" Content="CLOSE"
                    Style="{StaticResource PrimaryButton}" Padding="14,7"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>

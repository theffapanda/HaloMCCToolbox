                                        <TextBlock FontSize="11" LineHeight="18"><Run Foreground="{DynamicResource AccentBrush}" Text="LOG"/><Run Text=" — diagnostics"/></TextBlock>
                                        <TextBlock FontSize="11" LineHeight="18"><Run Foreground="{DynamicResource AccentBrush}" Text="ABOUT"/><Run Text=" — toolbox information"/></TextBlock>
                                    </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔨" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="BAN CHECKER" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="SidebarTheaterButton"
                                         GroupName="MainNavigation" Tag="Theater"
                                         Visibility="{Binding Visibility, ElementName=TheaterSection}"
                                         Style="{StaticResource SidebarNavButton}"
                                         Click="SidebarNavigation_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▣" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="THEATER" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="SidebarDownpatchButton" Visibility="{Binding Visibility, ElementName=DownpatchSection}" GroupName="MainNavigation" Tag="Downpatch" Style="{StaticResource SidebarNavButton}" Click="SidebarNavigation_Click">

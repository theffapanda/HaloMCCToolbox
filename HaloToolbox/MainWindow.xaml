                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="20"
                                Margin="0,0,0,14">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#x1F6E1; "
                                                   FontSize="16"
                                                   Foreground="#00C8FF"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="MCC P2P FIREWALL FIX"
                                                   FontFamily="Consolas"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="Blocks or unblocks TCP/UDP ports 3478 and 4379 for Halo MCC only. Other apps can keep using those ports."
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="18"/>
                                        <TextBlock x:Name="TxtSteamFirewallStatus"
                                                   Text="OFF - MCC-only firewall rules are disabled"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   Margin="0,8,0,0"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <CheckBox x:Name="ChkSteamFirewallAuto"
                                                  Content="AUTO DURING MATCHMAKING"
                                                  Style="{StaticResource MapCheckBox}"
                                                  FontSize="10"
                                                  Margin="0,8,0,0"
                                                  Checked="ChkSteamFirewallAuto_Checked"
                                                  Unchecked="ChkSteamFirewallAuto_Unchecked"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1"

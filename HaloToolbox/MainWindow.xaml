                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="□" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="ABOUT" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>

                        <Border Grid.Row="1"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Margin="9,4,9,10"
                                Padding="12,10"
                                TextOptions.TextFormattingMode="Ideal"
                                TextOptions.TextRenderingMode="Auto">
                            <StackPanel>
                                <TextBlock Text="TOOLBOX STATUS"
                                           FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Margin="0,0,0,8"/>
                                <Grid Margin="0,5" MinHeight="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="MCC" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#8499AC" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HomeMccStatus" Grid.Column="1" Text="CHECKING"
                                               FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                               Foreground="#71869A" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,5" MinHeight="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="MCC VPN" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#8499AC" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HomeVpnStatus" Grid.Column="1" Text="OFF"
                                               FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                               Foreground="#71869A" VerticalAlignment="Center"
                                               MaxWidth="105" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Grid Margin="0,5" MinHeight="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="PROXY"
                                               FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#8499AC" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HomeFeaturesStatus"
                                               Grid.Column="1"
                                               Text="● OFF"
                                               FontFamily="Consolas"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="#71869A"
                                               VerticalAlignment="Center"
                                               Margin="3,0,4,0"/>
                                    <Button x:Name="SidebarFeaturesToggleButton"
                                            Grid.Column="2"
                                            Content="START"
                                            Style="{StaticResource SidebarStatusActionButton}"
                                            ToolTip="Start the MCC data proxy without leaving this page"
                                            Click="BtnRejoinFix_Click"/>
                                </Grid>
                                <Grid Margin="0,5" MinHeight="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="WAYPOINT" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#8499AC" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatsHwStatusLabel" Grid.Column="1" Text="NOT CONNECTED"
                                               Margin="8,0,0,0"
                                               FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                               Foreground="#71869A" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- The original TabControl stays in place so startup restoration,
                     lazy section creation, and every existing handler keep working. -->
                <TabControl x:Name="MainTabs"
                        Grid.Column="1"
                        Style="{StaticResource DarkTab}"
                        Background="{DynamicResource BgBrush}"
                        Margin="0">

                <!-- Headers are replaced by the task sidebar; content ownership is unchanged. -->
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" Margin="0"/>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- ═══ TAB 1: TOOLS ═══ -->
                <TabItem x:Name="ToolsSection" Header="⚙  TOOLS" Style="{StaticResource DarkTabItem}">
                    <!-- No outer scroll — layout fills available space, map list scrolls internally -->
                    <Grid Margin="20,12,20,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- section label: Fix & Repair -->
                            <RowDefinition Height="Auto"/>  <!-- credentials card -->
                            <RowDefinition Height="Auto"/>  <!-- EAC card -->
                            <RowDefinition Height="Auto"/>  <!-- audio devices card -->
                            <RowDefinition Height="Auto"/>  <!-- rejoin fix card -->
                            <RowDefinition Height="Auto"/>  <!-- Steam firewall card -->
                            <RowDefinition Height="Auto"/>  <!-- MCC installation path -->
                            <RowDefinition Height="*"/>     <!-- map selector -->
                        </Grid.RowDefinitions>

                        <!-- Tools home: a lightweight task launcher. Existing tool
                             controls stay instantiated behind it so startup state,
                             bindings, and Rejoin events are unchanged. -->
                        <Grid x:Name="ToolsHomePanel" Grid.Row="0" Grid.RowSpan="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⌂ " FontSize="16" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="DASHBOARD" FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Everything in the Toolbox, organized around the task you want to complete."
                                               FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="14"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                        <TextBlock Text="📁 " FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="MCC INSTALLATION PATH"
                                                   FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="HomeMccPathText"
                                                 Grid.Column="0"
                                                 Style="{StaticResource DarkTextBox}"
                                                 Margin="0,0,8,0"
                                                 Text="{Binding Text, ElementName=TxtMccPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="1"
                                                Content="BROWSE"
                                                Style="{StaticResource PrimaryButton}"
                                                Padding="12,6"
                                                Click="BtnBrowse_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="14"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                        <TextBlock Text="♙ " FontSize="16" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="PLAYER &amp; WAYPOINT"
                                                   FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

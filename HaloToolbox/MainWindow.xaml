                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                        </Style>
                                    </UniformGrid.Resources>
                                    <StackPanel Margin="0,0,18,14">
                                        <TextBlock Text="HOME" Style="{StaticResource SidebarSectionLabel}" Margin="0,0,0,5"/>

                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap" Margin="0,7,0,0"/>
                                        <TextBlock x:Name="HomeProxyStatusText"
                                                   Text="○ STOPPED"
                                                   FontFamily="Consolas" FontSize="10"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Margin="0,8,0,0"/>
                                        <TextBlock x:Name="HomeProxyModeText"
                                                   Text=""
                                                   FontFamily="Consolas" FontSize="10"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Visibility="Collapsed" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="HomeProxyToggleButton"
                                            Grid.Column="1"
                                            Content="START PROXY"
                                            Style="{StaticResource OrangeButton}"
                                            Width="128"
                                            VerticalAlignment="Top"
                                            Click="BtnRejoinFix_Click"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="4"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Style="{StaticResource FlatScrollViewer}">

                                <StackPanel>

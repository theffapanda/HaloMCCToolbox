                                                       Foreground="{DynamicResource MutedBrush}" Margin="0,4,12,0"/>
                                        </StackPanel>
                                        <Button x:Name="StatsHwAuthBtn" Grid.Column="1"
                                                Content="CONNECT WAYPOINT"
                                                Style="{StaticResource PrimaryButton}"
                                                Padding="10,6"
                                                ToolTip="Sign in to Halo Waypoint to enable match history and recent 100-game stats."
                                                Click="StatsHwAuthBtn_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="3"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="14"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="↻ " FontSize="16" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="MCC DATA PROXY"
                                                       FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="Captures live MCC session data for Rejoin Recovery, overlays, and firewall automation."

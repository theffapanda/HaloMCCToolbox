                                        <TextBlock FontSize="11" LineHeight="18"><Run Foreground="{DynamicResource AccentBrush}" Text="BAN CHECKER"/><Run Text=" — MCC enforcement checks"/></TextBlock>
                                        <TextBlock FontSize="11" LineHeight="18"><Run Foreground="{DynamicResource AccentBrush}" Text="THEATER"/><Run Text=" — clip backups"/></TextBlock>
                                        <TextBlock FontSize="11" LineHeight="18"><Run Foreground="{DynamicResource AccentBrush}" Text="REPORT"/><Run Text=" — evidence packages"/></TextBlock>
                                    </StackPanel>
                                    <StackPanel Margin="0,14,18,0">
                                        <TextBlock Text="SYSTEM" Style="{StaticResource SidebarSectionLabel}" Margin="0,0,0,5"/>

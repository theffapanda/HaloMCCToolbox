                                    <TextBlock Text="✦" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="FIXES" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="SidebarLogButton"
                                         GroupName="MainNavigation" Tag="Log"
                                         Visibility="{Binding Visibility, ElementName=LogSection}"

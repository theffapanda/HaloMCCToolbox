                                    <TextBlock Text="▥" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="STATS" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="SidebarPopulationButton"
                                         GroupName="MainNavigation" Tag="Population"
                                         Visibility="{Binding Visibility, ElementName=PopulationSection}"

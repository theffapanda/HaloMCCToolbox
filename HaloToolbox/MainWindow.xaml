                                    <TextBlock Text="🔧" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="MODS" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="SidebarPlaylistsButton"
                                         GroupName="MainNavigation" Tag="Playlists"

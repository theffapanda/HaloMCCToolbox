                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◈" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="MCC VPN" VerticalAlignment="Center"/>
                                </StackPanel>

                                                    <TextBlock Text="elapsed 0:21" Foreground="#71869A" FontFamily="Consolas" FontSize="12" TextAlignment="Center" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="MatchmakingWaitPreviewModernPanel" Visibility="Collapsed"  Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="10">

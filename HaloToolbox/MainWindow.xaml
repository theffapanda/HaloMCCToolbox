                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="SEARCHING" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#00C8FF"/>
                                                        <TextBlock Grid.Column="1" Text="SOCIAL 4v4" FontFamily="Consolas" FontSize="9" Foreground="#71869A"/>
                                                    </Grid>
                                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <StackPanel><TextBlock Text="ESTIMATED" FontFamily="Consolas" FontSize="8" Foreground="#71869A"/><TextBlock Text="0:48" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="#D8E6EC"/></StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="ELAPSED" FontFamily="Consolas" FontSize="8" Foreground="#71869A"/><TextBlock Text="0:21" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="#39FF14" HorizontalAlignment="Right"/></StackPanel>
                                                    </Grid>
                                                    <TextBlock Grid.Row="3" Text="25 players searching across all gametypes" FontFamily="Consolas" FontSize="10" Foreground="#8EA4B8" TextWrapping="Wrap" Margin="0,7,0,0"/><Grid Grid.Row="2" Height="3" Margin="0,7,0,0"><Border Background="#24313A"/><Border Width="128" HorizontalAlignment="Left" Background="#00C8FF"/></Grid>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="SessionPreviewCard" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="11" Margin="0,6,6,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="SESSION STATS" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock x:Name="SessionPreviewStateText" Grid.Column="1" Text="OFF · CLASSIC" FontFamily="Consolas" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/>
                                            </Grid>
                                            <Border x:Name="SessionPreviewClassicPanel" Background="#D9080D12" BorderBrush="#3300C8FF" BorderThickness="1" CornerRadius="2" Padding="10">
                                                <Grid Height="76">
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    <TextBlock Text="SESSION  4 WINS / 2 LOSSES" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#00C8FF"/>
                                                    <TextBlock Grid.Row="1" Text="K/D: 1.34     WIN RATE: 67%" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#D8E6EC" Margin="0,9,0,0"/>
                                                    <TextBlock Grid.Row="2" Text="KILLS: 86     DEATHS: 64" FontFamily="Consolas" FontSize="9" Foreground="#71869A" Margin="0,8,0,0"/>
                                                </Grid>
                                            </Border>
                                            <Border x:Name="SessionPreviewModernPanel" Visibility="Collapsed" Background="#D9080D12" BorderBrush="#3300C8FF" BorderThickness="1" CornerRadius="2" Padding="10">
                                                <Grid Height="76">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0"><TextBlock Text="RECORD" FontFamily="Consolas" FontSize="8" Foreground="#71869A"/><TextBlock Text="4W - 2L" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="#39FF14" Margin="0,7,0,0"/></StackPanel>
                                                    <StackPanel Grid.Column="1"><TextBlock Text="K/D" FontFamily="Consolas" FontSize="8" Foreground="#71869A"/><TextBlock Text="1.34" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="#00C8FF" Margin="0,7,0,0"/></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock Text="KILLS / DEATHS" FontFamily="Consolas" FontSize="8" Foreground="#71869A"/><TextBlock Text="86 / 64" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="#D8E6EC" Margin="0,7,0,0"/></StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="CombinedPreviewCard" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="11" Margin="6,6,0,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="COMBINED NETWORK / SESSION" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock x:Name="CombinedPreviewStateText" Grid.Column="1" Text="OFF" FontFamily="Consolas" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/>
                                            </Grid>
                                            <Border Background="#D9080D12" BorderBrush="#3300C8FF" BorderThickness="1" CornerRadius="2" Padding="10">
                                                <Grid Height="76">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="NETWORK" FontFamily="Consolas" FontSize="8" FontWeight="Bold" Foreground="#00C8FF"/><TextBlock Text="PING  42 ms" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="#39FF14" Margin="0,7,0,0"/><TextBlock Text="UP 18  ·  DOWN 64 KB/s" FontFamily="Consolas" FontSize="8" Foreground="#71869A" Margin="0,5,0,0"/></StackPanel>
                                                    <Border Grid.Column="1" Background="#3300C8FF"/>
                                                    <StackPanel Grid.Column="2" Margin="10,0,0,0"><TextBlock Text="SESSION" FontFamily="Consolas" FontSize="8" FontWeight="Bold" Foreground="#71869A"/><TextBlock Text="4W - 2L" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="#39FF14" Margin="0,7,0,0"/><TextBlock Text="WIN 67%  ·  K/D 1.34" FontFamily="Consolas" FontSize="8" Foreground="#00C8FF" Margin="0,5,0,0"/></StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}">
                                                    <Run Foreground="{DynamicResource AccentBrush}" Text="🔨  "/><Run Text="CHECK PLAYER BANS"/>
                                                </TextBlock>
                                                <TextBlock Text="Check up to 15 gamertags or XUIDs using MCC authorization."
                                                           FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                                           Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="OPEN  ›" FontFamily="Consolas" FontSize="10"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </Grid>
                                    </Button>

                                    <Button Tag="Fixes" Style="{StaticResource HomeTaskButton}"
                                            Click="ToolsHomeTask_Click" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}">
                                                    <Run Foreground="{DynamicResource OrangeBrush}" Text="✦  "/><Run Text="FIX AN MCC PROBLEM"/>
                                                </TextBlock>
                                                <TextBlock Text="Repair sign-in, EasyAntiCheat, or audio-device issues."
                                                           FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="OPEN  ›" FontFamily="Consolas" FontSize="10"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </Grid>
                                    </Button>

                                    <Button Tag="Overlays" Style="{StaticResource HomeTaskButton}"
                                            Click="ToolsHomeTask_Click" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}">
                                                    <Run Foreground="{DynamicResource AccentBrush}" Text="▣  "/><Run Text="CONFIGURE OVERLAYS"/>

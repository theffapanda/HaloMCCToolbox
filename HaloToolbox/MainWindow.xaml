                                    <TextBlock Text="&#x1F6A8;" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="REPORT" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="SYSTEM" Style="{StaticResource SidebarSectionLabel}"/>

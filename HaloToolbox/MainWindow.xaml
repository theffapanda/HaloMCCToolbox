                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▧" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="LOG" VerticalAlignment="Center"/>
                                </StackPanel>

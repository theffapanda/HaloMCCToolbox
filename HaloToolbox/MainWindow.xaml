                        <Border x:Name="MccInstallationPathCard" Grid.Row="6" Visibility="Collapsed"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="16"
                                Margin="0,0,0,14">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Text="📁 " FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="MCC INSTALLATION PATH"
                                               FontFamily="Consolas"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtMccPath"
                                             Style="{StaticResource DarkTextBox}"
                                             Grid.Column="0"
                                             Margin="0,0,8,0"
                                             Text="C:\Program Files (x86)\Steam\steamapps\common\Halo The Master Chief Collection"/>
                                    <Button Content="BROWSE"
                                            Style="{StaticResource PrimaryButton}"
                                            Grid.Column="1"
                                            Click="BtnBrowse_Click"
                                            Padding="12,6"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Map Selector -->
                        <Border x:Name="MapSelectorPanel" Grid.Row="7" Visibility="Collapsed"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Stretch">
                            <Expander IsExpanded="True" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                        <TextBlock Text="🗺 "
                                                   FontSize="16"
                                                   Foreground="#00C8FF"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="HALO 3 MULTIPLAYER MAP SELECTOR"
                                                   FontFamily="Consolas"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#00C8FF"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                        <!-- Map details -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Only Halo 3 maps can be removed without getting kicked. Unchecked maps are renamed with REMOVED_ so MCC ignores them. Click any row to toggle."
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="17"
                                       Margin="0,0,0,10"/>
                        </StackPanel>

                        <!-- All action buttons in one row -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="⟳  LOAD MAPS"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="BtnLoadMaps_Click"
                                    Margin="0,0,8,0"/>
                            <Button Content="✓  ENABLE ALL"
                                    Style="{StaticResource GreenButton}"
                                    Click="BtnEnableAll_Click"
                                    Margin="0,0,8,0"/>
                            <Button Content="✕  DISABLE ALL"
                                    Style="{StaticResource RedButton}"
                                    Click="BtnDisableAll_Click"
                                    Margin="0,0,8,0"/>
                            <Button Content="🚫  DISABLE 343 MAPS"
                                    Style="{StaticResource RedButton}"
                                    Click="BtnDisable343_Click"
                                    Padding="12,8"
                                    FontSize="11"/>
                        </StackPanel>

                        <!-- Map list — fills all remaining vertical space -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Style="{StaticResource FlatScrollViewer}"
                                          Padding="0,0">
                                <ItemsControl x:Name="MapList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Header row (section divider) -->
                                            <Border x:Name="RowBd"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="14,10"
                                                    MouseLeftButtonUp="MapRow_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Style.Triggers>
                                                            <!-- Header rows: not clickable, distinct style -->
                                                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                                                                <Setter Property="Cursor" Value="Arrow"/>
                                                                <Setter Property="Padding" Value="14,12"/>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsHeader}" Value="False"/>
                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background" Value="#0D1820"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <Grid>
                                                    <!-- HEADER DISPLAY -->
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="#FF6A00"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- MAP ROW DISPLAY -->
                                                    <Grid>
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Checkbox indicator -->
                                                        <Border Grid.Column="0"
                                                                Width="20" Height="20"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,12,0"
                                                                CornerRadius="2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#39FF14"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="✓"
                                                                       FontSize="13"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#39FF14"/>
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <!-- Map name — modded maps shown in orange -->
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DisplayName}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="14"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsModded}" Value="True">
                                                                            <Setter Property="Foreground" Value="#CC8833"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- Right-side badges -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <!-- MOD badge -->
                                                            <Border Background="#1A331A00"
                                                                    BorderBrush="#CC8833"
                                                                    BorderThickness="1"
                                                                    CornerRadius="2"
                                                                    Padding="5,2"
                                                                    Margin="6,0,0,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsModded}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="MOD"
                                                                           FontFamily="Consolas"
                                                                           FontSize="9"
                                                                           FontWeight="Bold"
                                                                           Foreground="#CC8833"/>
                                                            </Border>

                                                            <!-- REMOVED badge -->
                                                            <TextBlock Text="REMOVED"
                                                                       FontFamily="Consolas"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="#FF2D55"
                                                                       VerticalAlignment="Center"
                                                                       Margin="8,0,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Status -->
                        <TextBlock Grid.Row="3"
                                   x:Name="TxtMapStatus"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,8,0,0"
                                   Text="No maps loaded. Set your MCC path and click LOAD MAPS."/>
                                </Grid>
                            </Expander>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ═══ TAB 2: MODS ═══ -->
                <TabItem x:Name="H3ModsSection" Header="🔧  MODS" Style="{StaticResource DarkTabItem}">
                    <ContentControl x:Name="ModsHost">
                        <TextBlock Text="Mods load when this tab is opened."
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontFamily="Consolas"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </ContentControl>
                </TabItem>

                <!-- ═══ TAB 2: LOG ═══ -->
                <!-- ═══ TAB 3: REPORT PLAYER ═══ -->
                <TabItem x:Name="ReportSection" Header="🚨  REPORT" Style="{StaticResource DarkTabItem}">
                    <Grid Margin="20,12,20,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- header / load button -->
                            <RowDefinition Height="Auto"/>  <!-- game info bar -->
                            <RowDefinition Height="*"/>     <!-- scoreboard -->
                            <RowDefinition Height="Auto"/>  <!-- form -->
                            <RowDefinition Height="Auto"/>  <!-- export button -->
                        </Grid.RowDefinitions>

                        <!-- Header row -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="🚨 " FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="REPORT A PLAYER"
                                               FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                               Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Loads the last game's carnage report, lets you select the player to report, and bundles everything into a ZIP with your theater evidence."
                                           FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap" LineHeight="17"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    x:Name="BtnLoadCarnage"
                                    Content="⟳  LOAD LAST GAME"
                                    Style="{StaticResource PrimaryButton}"
                                    VerticalAlignment="Center"
                                    Click="BtnLoadCarnage_Click"/>
                        </Grid>

                        <!-- Game info bar -->
                        <Border Grid.Row="1"
                                x:Name="GameInfoBar"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="14,8"
                                Margin="0,0,0,8"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="GAME TYPE  " FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtGameMap" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#00C8FF" VerticalAlignment="Center"/>
                                    <TextBlock Text="   ·   " FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="MAP  " FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtGameMode" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                                    <TextBlock Text="DATE  " FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtGameDate" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           x:Name="TxtCarnageFile"
                                           FontFamily="Consolas" FontSize="9"
                                           Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"
                                           Margin="20,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Scoreboard -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- column headers -->
                                    <RowDefinition Height="*"/>    <!-- player rows -->
                                </Grid.RowDefinitions>

                                <!-- Column headers -->
                                <Border Grid.Row="0"
                                        Background="{DynamicResource BgBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="14,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>   <!-- select indicator -->
                                            <ColumnDefinition Width="*"/>    <!-- gamertag -->
                                            <ColumnDefinition Width="55"/>   <!-- score -->
                                            <ColumnDefinition Width="55"/>   <!-- kills -->
                                            <ColumnDefinition Width="55"/>   <!-- deaths -->
                                            <ColumnDefinition Width="55"/>   <!-- assists -->
                                            <ColumnDefinition Width="40"/>   <!-- team -->
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"/>
                                        <TextBlock Grid.Column="1" Text="GAMERTAG" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock Grid.Column="2" Text="SCORE" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="KILLS" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="DEATHS" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="ASSISTS" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="TEAM" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Player rows -->
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              Style="{StaticResource FlatScrollViewer}">
                                    <ItemsControl x:Name="ScoreboardList" Loaded="ReportScoreboard_Loaded">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="14,9"
                                                        Cursor="Hand"
                                                        MouseLeftButtonUp="ScoreboardRow_Click">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="#1A0000"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#0D1820"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="55"/>
                                                            <ColumnDefinition Width="55"/>
                                                            <ColumnDefinition Width="55"/>
                                                            <ColumnDefinition Width="55"/>
                                                            <ColumnDefinition Width="40"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Selected indicator -->
                                                        <TextBlock Grid.Column="0"
                                                                   Text="▶"
                                                                   FontSize="11"
                                                                   Foreground="#FF2D55"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- Gamertag -->
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Gamertag}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Foreground" Value="#FF2D55"/>
                                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- Stats columns -->
                                                        <TextBlock Grid.Column="2" Text="{Binding Score}"   FontFamily="Consolas" FontSize="13" Foreground="#FFD700" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Kills}"   FontFamily="Consolas" FontSize="13" Foreground="#39FF14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding Deaths}"  FontFamily="Consolas" FontSize="13" Foreground="#FF2D55" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding Assists}" FontFamily="Consolas" FontSize="13" Foreground="#00C8FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="6" Text="{Binding Team}"    FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Report form -->
                        <Border Grid.Row="3"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="16,12"
                                Margin="0,8,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>  <!-- row 0: reported player + game title -->
                                    <RowDefinition Height="Auto"/>  <!-- row 1: cheat type + map -->
                                    <RowDefinition Height="Auto"/>  <!-- row 2: theater (hidden for CE/H2) -->
                                    <RowDefinition Height="Auto"/>  <!-- row 3: additional notes -->
                                </Grid.RowDefinitions>

                                <!-- Reported player display -->
                                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="REPORTED PLAYER" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtSelectedPlayer"
                                               Text="Click a player on the scoreboard above"
                                               FontFamily="Consolas" FontSize="13"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>

                                <!-- Game title selector -->
                                <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="GAME TITLE" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CboGameTitle"
                                              Style="{StaticResource DarkCombo}"
                                              FontFamily="Consolas"
                                              FontSize="12"
                                              SelectedIndex="3"
                                              SelectionChanged="CboGameTitle_SelectionChanged">
                                        <ComboBoxItem Content="Halo CE"/>
                                        <ComboBoxItem Content="Halo 2"/>
                                        <ComboBoxItem Content="Halo 2 Anniversary"/>
                                        <ComboBoxItem Content="Halo 3"/>
                                        <ComboBoxItem Content="Halo Reach"/>
                                        <ComboBoxItem Content="Halo 4"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Cheat type -->
                                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,0,10">
                                    <TextBlock Text="BEHAVIOR / REASON" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CboReportReason"
                                              Style="{StaticResource DarkCombo}"
                                              FontFamily="Consolas"
                                              FontSize="12">
                                        <ComboBoxItem Content="Abusive communication: Discriminatory language" Tag="Discriminatory language"/>
                                        <ComboBoxItem Content="Abusive communication: Harassment/bullying" Tag="Harassment/bullying"/>
                                        <ComboBoxItem Content="Abusive communication: Vulgar language" Tag="Vulgar language"/>
                                        <ComboBoxItem Content="Unsporting conduct: Team killing or self-destruction" Tag="Team killing or self-destruction"/>
                                        <ComboBoxItem Content="Unsporting conduct: Idling/quitting" Tag="Idling/quitting"/>
                                        <ComboBoxItem Content="Inappropriate user generated content" Tag="Inappropriate user generated content"/>
                                        <ComboBoxItem Content="Cheating: Aimbot / Auto-aim" Tag="Cheating"/>
                                        <ComboBoxItem Content="Cheating: Wall hacks / ESP" Tag="Cheating"/>
                                        <ComboBoxItem Content="Cheating: Speed / movement hacks" Tag="Cheating"/>
                                        <ComboBoxItem Content="Cheating: God mode / invincibility" Tag="Cheating"/>
                                        <ComboBoxItem Content="Cheating: Map exploits / out of bounds" Tag="Cheating"/>
                                        <ComboBoxItem Content="Cheating: Score / stat manipulation" Tag="Cheating"/>
                                        <ComboBoxItem Content="Cheating: Host manipulation / lag switching" Tag="Cheating"/>
                                        <ComboBoxItem Content="Cheating: Other (see description)" Tag="Cheating"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Map played (filtered by selected game) -->
                                <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,10">
                                    <TextBlock Text="MAP PLAYED ON" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CboReportMap"
                                              Style="{StaticResource DarkCombo}"
                                              FontFamily="Consolas"
                                              FontSize="12"/>
                                </StackPanel>

                                <!-- Theater file count — hidden for CE and H2 (no Film mode) -->
                                <StackPanel x:Name="TheaterPanel"
                                            Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2"
                                            Margin="0,0,0,10">
                                    <TextBlock Text="THEATER FILES FOUND" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtTheaterCount"
                                               Text="— select a map first —"
                                               FontFamily="Consolas" FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>

                                <!-- Additional notes — spans full width -->
                                <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="3">
                                    <TextBlock Text="ADDITIONAL NOTES" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtReportNotes"
                                             Style="{StaticResource DarkTextBox}"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             Height="56"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Text=""
                                             ToolTip="Describe what happened, including timestamps and whether it was voice or text chat. Attach screenshots or recordings in Halo Support for communication reports."/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Export button row -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtReportStatus"
                                       FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center"
                                       Text="Load a game, select the player to report, fill in the form, then export."/>
                            <Button Grid.Column="1"
                                    x:Name="BtnBuildReport"
                                    Content="📦  BUILD REPORT ZIP"
                                    Style="{StaticResource OrangeButton}"
                                    Click="BtnBuildReport_Click"
                                    Padding="18,10"
                                    FontSize="12"/>
                            <!-- Support button + live session indicator -->
                            <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                                <Button x:Name="BtnSubmitHalo"
                                        Content="🌐  OPEN HALO SUPPORT"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="BtnSubmitHalo_Click"
                                        Padding="18,10"
                                        FontSize="12"
                                        ToolTip="Opens the Halo Support ticket form pre-filled with all report details. Sign in, attach your ZIP, and click Submit."/>
                                <!-- Session status pill — updated by CheckSupportSessionAsync -->
                                <TextBlock x:Name="TxtSupportSessionStatus"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"
                                           Text="● session not checked"
                                           Foreground="{DynamicResource MutedBrush}"
                                           ToolTip="Indicates whether a Halo Support / Microsoft Account session is stored locally. Green = already logged in. Red = will need to log in."/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ═══ TAB 3: STATS ═══ -->
                <TabItem x:Name="StatsSection" Header="📊  STATS" Style="{StaticResource DarkTabItem}">
                    <TabItem.Resources>
                        <!-- ListView implicit styles scoped to this tab only -->
                        <Style TargetType="ListView">
                            <Setter Property="Background"      Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground"      Value="{DynamicResource TextBrush}"/>
                        </Style>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Background"                  Value="{DynamicResource SurfaceBrush}"/>
                            <Setter Property="Foreground"                  Value="{DynamicResource MutedBrush}"/>
                            <Setter Property="BorderBrush"                 Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="BorderThickness"             Value="0,0,0,1"/>
                            <Setter Property="Padding"                     Value="8,5"/>
                            <Setter Property="FontFamily"                  Value="Consolas"/>
                            <Setter Property="FontSize"                    Value="11"/>
                            <Setter Property="FontWeight"                  Value="SemiBold"/>
                            <Setter Property="HorizontalContentAlignment"  Value="Left"/>
                        </Style>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding"  Value="0"/>
                            <Setter Property="Margin"   Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0">
                                            <GridViewRowPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StatsHoverRowBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMe}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource StatsMyRowBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource StatsScanRowBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Team}" Value="0">
                                    <Setter Property="Background" Value="{DynamicResource StatsTeam0RowBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Team}" Value="1">
                                    <Setter Property="Background" Value="{DynamicResource StatsTeam1RowBrush}"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMe}" Value="True"/>
                                        <Condition Binding="{Binding Team}" Value="0"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource StatsMyRowBrush}"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMe}" Value="True"/>
                                        <Condition Binding="{Binding Team}" Value="1"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource StatsMyRowBrush}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TabItem.Resources>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- 0: Stats bar -->
                            <RowDefinition Height="Auto"/> <!-- 1: Buttons -->
                            <RowDefinition Height="Auto"/> <!-- 2: Team summary -->
                            <RowDefinition Height="*"/>    <!-- 3: Lobby list -->
                            <RowDefinition Height="Auto"/> <!-- 4: Status bar -->
                        </Grid.RowDefinitions>

                        <!-- ── Row 0: Stats summary bar ───────────────────────────────── -->
                        <Border Grid.Row="0" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1" Padding="14,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Lifetime K/D -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="LIFETIME" FontFamily="Consolas" FontSize="10"
                                               FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="K/D " FontFamily="Consolas" FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatsLifetimeKdLabel" Text="—"
                                               FontFamily="Consolas" FontSize="20" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                               Margin="0,0,16,0"/>
                                    <TextBlock x:Name="StatsLifetimeTotalsLabel" Text=""
                                               FontFamily="Consolas" FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Session stats -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,14,0">
                                    <TextBlock Text="SESSION" FontFamily="Consolas" FontSize="10"
                                               FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="StatsWinsLabel" Text="0W"
                                               FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                               Foreground="#39FF14" VerticalAlignment="Center"/>
                                    <TextBlock Text=" – " FontFamily="Consolas" FontSize="16"
                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatsLossesLabel" Text="0L"
                                               FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                               Foreground="#FF2D55" VerticalAlignment="Center"/>
                                    <TextBlock Text="  ·  " FontFamily="Consolas" FontSize="14"
                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="K/D " FontFamily="Consolas" FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatsSessionKdLabel" Text="—"
                                               FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="  ·  " FontFamily="Consolas" FontSize="14"
                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatsSessionKillsLabel" Text="0K"
                                               FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                               Foreground="#39FF14" VerticalAlignment="Center"/>
                                    <TextBlock Text=" / " FontFamily="Consolas" FontSize="14"
                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatsSessionDeathsLabel" Text="0D"
                                               FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                               Foreground="#FF2D55" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock x:Name="StatsGamesLabel" Grid.Column="2"
                                           Text="0 games"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- ── Row 1: Action buttons ──────────────────────────────────── -->
                        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1" Padding="14,8">
                            <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button x:Name="StatsSyncBtn"
                                        Content="↻ SYNC STATS"
                                        Style="{StaticResource PrimaryButton}"
                                        ToolTip="Refresh lifetime stats for the applied gamertag."
                                        Margin="0,0,6,0"
                                        Click="StatsSyncBtn_Click"/>
                                <Button x:Name="StatsResetBtn"
                                        Content="⟳ RESET SESSION"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,6,0"
                                        Click="StatsResetBtn_Click"/>
                                <Button x:Name="StatsLastGameBtn"
                                        Content="↺ LAST GAME"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,6,0"
                                        Click="StatsLastGameBtn_Click"/>
                                <Button x:Name="StatsScanBtn"
                                        Content="▶ SCAN LOBBY"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,6,0"
                                        Click="StatsScanBtn_Click"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ToggleButton x:Name="StatsLobbyViewBtn"
                                              Content="LOBBY VIEW"
                                              Style="{StaticResource StatsToggleBtn}"
                                              IsChecked="True"
                                              Padding="12,5"
                                              Click="StatsLobbyView_Click"/>
                                <ToggleButton x:Name="StatsSessionViewBtn"
                                              Content="SESSION VIEW"
                                              Style="{StaticResource StatsToggleBtn}"
                                              Margin="6,0,0,0"
                                              Padding="12,5"
                                              Click="StatsSessionView_Click"/>
                            </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- ── Row 4: Team summary bar (hidden until team game detected) ── -->
                        <Border x:Name="StatsTeamSummaryBar"
                                  Grid.Row="2"
                                Background="{DynamicResource BgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="16,10"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Team 0 (Red) -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock x:Name="StatsTeam0Label" Text="TEAM 0"
                                               FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#FF4444" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="StatsTeam0AvgLabel" Text="—"
                                               FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                                               Foreground="#FF4444" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="StatsTeam0GamesLabel" Text=""
                                               FontFamily="Consolas" FontSize="10"
                                               Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="StatsTeam0FavoredLabel" Text=""
                                               FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#39FF14" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="vs"
                                           FontFamily="Consolas" FontSize="14"
                                           Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center" Margin="24,0"/>

                                <!-- Team 1 (Blue) -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock x:Name="StatsTeam1Label" Text="TEAM 1"
                                               FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#4499FF" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="StatsTeam1AvgLabel" Text="—"
                                               FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                                               Foreground="#4499FF" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="StatsTeam1GamesLabel" Text=""
                                               FontFamily="Consolas" FontSize="10"
                                               Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="StatsTeam1FavoredLabel" Text=""
                                               FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#39FF14" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ── Row 5: Current lobby + last game ────────────────────────── -->
                        <Grid x:Name="StatsLobbyContent" Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="StatsCurrentLobbyHeaderRow" Height="Auto"/>
                                <RowDefinition x:Name="StatsCurrentLobbyListRow" Height="260" MinHeight="170"/>
                                <RowDefinition x:Name="StatsCurrentLobbySplitterRow" Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="170"/>
                            </Grid.RowDefinitions>

                            <Border x:Name="StatsCurrentLobbyHeader"
                                    Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1" Padding="14,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="CURRENT LOBBY"
                                               FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock x:Name="StatsCurrentLobbyServerLabel"
                                               Text=""
                                               FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedBrush}"
                                               Margin="12,0,0,0"/>
                                    <TextBlock x:Name="StatsMatchmakingWaitLabel"
                                               Text=""
                                               FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#FFB020"
                                               Margin="18,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <ListView x:Name="StatsCurrentLobbyList"
                                      Grid.Row="1"
                                      SelectionMode="Single"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      MouseDoubleClick="StatsLobbyList_MouseDoubleClick">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="PLAYER" Width="220">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontFamily="Consolas" Padding="6,5">
                                                        <Hyperlink NavigateUri="{Binding WortUrl}"
                                                                   Foreground="{Binding GamertagColor}"
                                                                   TextDecorations="None"
                                                                   RequestNavigate="ExternalHyperlink_RequestNavigate">
                                                            <Run Text="{Binding Gamertag, Mode=OneWay}"/>
                                                        </Hyperlink>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="SQUAD" Width="70">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SquadLabel}"
                                                               ToolTip="{Binding SquadToolTip}"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontFamily="Consolas"
                                                               FontWeight="SemiBold"
                                                               Padding="6,5"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="BEST SERVER" Width="140">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding BestServer}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               FontFamily="Consolas"
                                                               Padding="6,5"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="K/D" Width="70">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding KD}"
                                                               Foreground="{Binding KdColor}"
                                                               FontFamily="Consolas" FontWeight="SemiBold"
                                                               Padding="6,5" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="MMR %" Width="72">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SkillPercentile}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               FontFamily="Consolas" FontWeight="SemiBold"
                                                               Padding="6,5" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <GridSplitter x:Name="StatsCurrentLobbySplitter"
                                          Grid.Row="2"
                                          Height="5"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Background="{DynamicResource BorderBrush}"
                                          ResizeDirection="Rows"
                                          ResizeBehavior="PreviousAndNext"/>

                            <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,1" Padding="14,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="LAST GAME"
                                               FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock x:Name="StatsLastGameServerLabel"
                                               Text=""
                                               FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedBrush}"
                                               Margin="12,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <ListView x:Name="StatsLobbyList"
                                      Grid.Row="4"
                                      SelectionMode="Single"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      MouseDoubleClick="StatsLobbyList_MouseDoubleClick">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="PLAYER" Width="190">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontFamily="Consolas" Padding="6,5">
                                                        <Hyperlink NavigateUri="{Binding WortUrl}"
                                                                   Foreground="{Binding GamertagColor}"
                                                                   TextDecorations="None"
                                                                   RequestNavigate="ExternalHyperlink_RequestNavigate">
                                                            <Run Text="{Binding Gamertag, Mode=OneWay}"/>
                                                        </Hyperlink>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="RESULT" Width="70">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding MatchResult}"
                                                               Foreground="{Binding MatchResultColor}"
                                                               FontFamily="Consolas" FontWeight="SemiBold"
                                                               Padding="6,5" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="SCORE / POINTS" Width="105">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding MatchScore}"
                                                               Foreground="#FFD700"
                                                               FontFamily="Consolas" FontWeight="SemiBold"
                                                               Padding="6,5" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="K" Width="48">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding MatchKills}" Foreground="#39FF14"
                                                               FontFamily="Consolas" Padding="6,5" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="D" Width="48">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding MatchDeaths}" Foreground="#FF2D55"
                                                               FontFamily="Consolas" Padding="6,5" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="A" Width="48">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding MatchAssists}" Foreground="{DynamicResource AccentBrush}"
                                                               FontFamily="Consolas" Padding="6,5" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="OBJECTIVE STATS" Width="230">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding MatchObjectiveStats}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontFamily="Consolas"
                                                               Padding="6,5"
                                                               ToolTip="{Binding MatchObjectiveStats}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="TEAM" Width="62">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding TeamLabel}" Foreground="{DynamicResource MutedBrush}"
                                                               FontFamily="Consolas" Padding="6,5" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="CAREER K/D" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding KD}" Foreground="{Binding KdColor}"
                                                               FontFamily="Consolas" FontWeight="SemiBold"
                                                               Padding="6,5" HorizontalAlignment="Center"
                                                               ToolTip="{Binding Totals}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="GAMES" Width="76">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding GamesPlayed}" Foreground="{DynamicResource MutedBrush}"
                                                               FontFamily="Consolas" Padding="6,5" HorizontalAlignment="Right"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="SQUAD" Width="62">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SquadLabel}" ToolTip="{Binding SquadToolTip}"
                                                               Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas"
                                                               FontWeight="SemiBold" Padding="6,5" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="BEST SERVER" Width="115">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding BestServer}" Foreground="{DynamicResource MutedBrush}"
                                                               FontFamily="Consolas" Padding="6,5" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="RECENT (100G)" Width="125">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="6,3">
                                                        <TextBlock Text="{Binding RecentKD}" Foreground="{Binding RecentKdColor}"
                                                                   FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding RecentTrend}" Foreground="{Binding TrendColor}"
                                                                   FontFamily="Consolas" FontSize="11" Margin="4,0,0,1"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>

                        <!-- Advanced session dashboard. It overlays rows 3-5 when
                             SESSION VIEW is selected, preserving the existing lobby UI. -->
                        <Border x:Name="StatsSessionContent"
                                Grid.Row="3" Grid.RowSpan="3"
                                Panel.ZIndex="20"
                                Visibility="Collapsed"
                                Background="{DynamicResource BgBrush}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="14,12">
                                    <UniformGrid Columns="6" Margin="0,0,0,10">
                                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,6,0">
                                            <StackPanel><TextBlock Text="RECORD" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="StatsDashboardRecord" Text="0W–0L" FontFamily="Consolas" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,6,0">
                                            <StackPanel><TextBlock Text="WIN RATE" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="StatsDashboardWinRate" Text="—" FontFamily="Consolas" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,6,0">
                                            <StackPanel><TextBlock Text="K/D" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="StatsDashboardKd" Text="—" FontFamily="Consolas" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,6,0">
                                            <StackPanel><TextBlock Text="KILLS" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="StatsDashboardKills" Text="0" FontFamily="Consolas" FontSize="21" FontWeight="Bold" Foreground="#39FF14" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,6,0">
                                            <StackPanel><TextBlock Text="DEATHS" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="StatsDashboardDeaths" Text="0" FontFamily="Consolas" FontSize="21" FontWeight="Bold" Foreground="#FF2D55" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10">
                                            <StackPanel><TextBlock Text="BEST SPREE" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="StatsDashboardBestSpree" Text="0" FontFamily="Consolas" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="MULTIKILL TOTALS" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                                <UniformGrid Columns="9">
                                                    <StackPanel><Image Source="Resources/Medals/double-kill.png" Width="58" Height="58"/><TextBlock Text="DOUBLE" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="StatsMedalDouble" Text="0" FontFamily="Consolas" FontSize="17" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/></StackPanel>
                                                    <StackPanel><Image Source="Resources/Medals/triple-kill.png" Width="58" Height="58"/><TextBlock Text="TRIPLE" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="StatsMedalTriple" Text="0" FontFamily="Consolas" FontSize="17" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/></StackPanel>
                                                    <StackPanel><Image Source="Resources/Medals/overkill.png" Width="58" Height="58"/><TextBlock Text="OVERKILL" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="StatsMedalOverkill" Text="0" FontFamily="Consolas" FontSize="17" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/></StackPanel>
                                                    <StackPanel><Image Source="Resources/Medals/killtacular.png" Width="58" Height="58"/><TextBlock Text="KILLTACULAR" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="StatsMedalKilltacular" Text="0" FontFamily="Consolas" FontSize="17" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/></StackPanel>
                                                    <StackPanel><Image Source="Resources/Medals/killtrocity.png" Width="58" Height="58"/><TextBlock Text="KILLTROCITY" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="StatsMedalKilltrocity" Text="0" FontFamily="Consolas" FontSize="17" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/></StackPanel>
                                                    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="3"><StackPanel><Image Source="Resources/Medals/killimanjaro.png" Width="58" Height="58"/><TextBlock Text="KILLIMANJARO" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="StatsMedalKillimanjaro" Text="0" FontFamily="Consolas" FontSize="17" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/></StackPanel></Border>
                                                    <StackPanel Opacity="0.55"><Image Source="Resources/Medals/killtastrophe.png" Width="58" Height="58"/><TextBlock Text="KILLTASTROPHE" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="StatsMedalKilltastrophe" Text="0" FontFamily="Consolas" FontSize="17" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/></StackPanel>
                                                    <StackPanel Opacity="0.55"><Image Source="Resources/Medals/killpocalypse.png" Width="58" Height="58"/><TextBlock Text="KILLPOCALYPSE" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="StatsMedalKillpocalypse" Text="0" FontFamily="Consolas" FontSize="17" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/></StackPanel>
                                                    <StackPanel Opacity="0.55"><Image Source="Resources/Medals/killionaire.png" Width="58" Height="58"/><TextBlock Text="KILLIONAIRE" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="StatsMedalKillionaire" Text="0" FontFamily="Consolas" FontSize="17" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/></StackPanel>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="SESSION HIGHLIGHTS" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                                                <TextBlock Text="BEST GAME" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="StatsDashboardBestGame" Text="—" FontFamily="Consolas" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,1,0,8"/>
                                                <TextBlock Text="BEST K/D" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="StatsDashboardBestKd" Text="—" FontFamily="Consolas" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,1,0,8"/>
                                                <TextBlock Text="WIN STREAK" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="StatsDashboardWinStreak" Text="0" FontFamily="Consolas" FontSize="18" Foreground="#39FF14"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0" LastChildFill="True" Background="{DynamicResource PanelBrush}">
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                    <ToggleButton x:Name="StatsSessionGamesTab"
                                                                  Style="{StaticResource StatsToggleBtn}"
                                                                  IsChecked="True"
                                                                  BorderThickness="0,0,1,0"
                                                                  Click="StatsSessionGamesTab_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="GAME TIMELINE"/>
                                                            <Border BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" BorderThickness="1" Margin="8,0,0,0" Padding="4,0">
                                                                <TextBlock x:Name="StatsSessionGameCountLabel" Text="0"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <ToggleButton x:Name="StatsSessionPlayersTab"
                                                                  Style="{StaticResource StatsToggleBtn}"
                                                                  BorderThickness="0,0,1,0"
                                                                  Click="StatsSessionPlayersTab_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="ALL PLAYERS"/>
                                                            <Border BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" BorderThickness="1" Margin="8,0,0,0" Padding="4,0">
                                                                <TextBlock x:Name="StatsSessionPlayerCountLabel" Text="0"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                </StackPanel>
                                                <TextBlock Text="SELECT A GAME TO INSPECT ITS CAPTURED LOBBY"
                                                           FontFamily="Consolas" FontSize="9"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           Margin="10,0,12,0"/>
                                            </DockPanel>

                                            <Grid x:Name="StatsSessionGamesPanel" Grid.Row="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Height="27">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52"/>
                                                        <ColumnDefinition Width="88"/>
                                                        <ColumnDefinition Width="92"/>
                                                        <ColumnDefinition Width="82"/>
                                                        <ColumnDefinition Width="103"/>
                                                        <ColumnDefinition Width="190"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="GAME" Margin="9,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource MutedBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="RESULT" Margin="9,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource MutedBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="K–D" Margin="9,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource MutedBrush}"/>
                                                    <TextBlock Grid.Column="3" Text="K/D" Margin="9,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource MutedBrush}"/>
                                                    <TextBlock Grid.Column="4" Text="BEST SPREE" Margin="9,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource MutedBrush}"/>
                                                    <TextBlock Grid.Column="5" Text="HIGHEST MULTIKILL" Margin="9,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource MutedBrush}"/>
                                                    <TextBlock Grid.Column="6" Text="LOBBY" Margin="9,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource MutedBrush}"/>
                                                </Grid>
                                                <ScrollViewer Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl x:Name="StatsSessionTimelineList">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                                          BorderBrush="{DynamicResource BorderBrush}"
                                                                          BorderThickness="0,0,0,1"
                                                                          Background="{DynamicResource BgBrush}">
                                                                    <Expander.Header>
                                                                        <Grid MinHeight="38">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="34"/>
                                                                                <ColumnDefinition Width="88"/>
                                                                                <ColumnDefinition Width="92"/>
                                                                                <ColumnDefinition Width="82"/>
                                                                                <ColumnDefinition Width="103"/>
                                                                                <ColumnDefinition Width="190"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding Game}" Margin="7,0" VerticalAlignment="Center" FontFamily="Consolas" Foreground="{DynamicResource TextBrush}"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding Result}" Margin="9,0" VerticalAlignment="Center" FontFamily="Consolas" FontWeight="Bold" Foreground="{Binding ResultColor}"/>
                                                                            <TextBlock Grid.Column="2" Text="{Binding KillsDeaths}" Margin="9,0" VerticalAlignment="Center" FontFamily="Consolas" Foreground="{DynamicResource TextBrush}"/>
                                                                            <TextBlock Grid.Column="3" Text="{Binding KD}" Margin="9,0" VerticalAlignment="Center" FontFamily="Consolas" Foreground="{DynamicResource TextBrush}"/>
                                                                            <TextBlock Grid.Column="4" Text="{Binding BestSpree}" Margin="9,0" VerticalAlignment="Center" FontFamily="Consolas" Foreground="{DynamicResource TextBrush}"/>
                                                                            <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="7,0">
                                                                                <Image Source="{Binding HighestMultikillIcon}" Width="24" Height="24" Margin="0,0,7,0"/>
                                                                                <TextBlock Text="{Binding HighestMultikill}" VerticalAlignment="Center" FontFamily="Consolas" Foreground="{DynamicResource TextBrush}"/>
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0">
                                                                                <TextBlock Text="{Binding LobbyPlayerCount}" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas"/>
                                                                                <TextBlock Text=" PLAYERS  ·  " Foreground="{DynamicResource MutedBrush}" FontFamily="Consolas"/>
                                                                                <TextBlock Text="{Binding PlayedAt}" Foreground="{DynamicResource MutedBrush}" FontFamily="Consolas"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Expander.Header>
                                                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8">
                                                                        <ItemsControl ItemsSource="{Binding LobbyTeams}" Tag="{Binding LobbyColumnCount}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBrush}" Margin="4">
                                                                                        <StackPanel>
                                                                                            <DockPanel Background="{DynamicResource BgBrush}" MinHeight="30" LastChildFill="True">
                                                                                                <Border Width="4" Background="{Binding TeamColor}" DockPanel.Dock="Left"/>
                                                                                                <TextBlock Text="{Binding TeamName}" Margin="9,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Foreground="{Binding TeamColor}"/>
                                                                                                <TextBlock Text="{Binding PlayerCountText}" Margin="9,0" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource MutedBrush}"/>
                                                                                            </DockPanel>
                                                                                            <Grid Height="23" Background="{DynamicResource SurfaceBrush}">
                                                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                                                                                <TextBlock Grid.Column="0" Text="GAMERTAG" Margin="8,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource MutedBrush}"/>
                                                                                                <TextBlock Grid.Column="1" Text="MET" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource MutedBrush}"/>
                                                                                                <TextBlock Grid.Column="2" Text="K" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource MutedBrush}"/>
                                                                                                <TextBlock Grid.Column="3" Text="D" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource MutedBrush}"/>
                                                                                                <TextBlock Grid.Column="4" Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource MutedBrush}"/>
                                                                                            </Grid>
                                                                                            <ItemsControl ItemsSource="{Binding Players}">
                                                                                                <ItemsControl.ItemTemplate>
                                                                                                    <DataTemplate>
                                                                                                        <Grid MinHeight="29">
                                                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                                                                                            <TextBlock Grid.Column="0" Text="{Binding Gamertag}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontFamily="Consolas" FontSize="10" Foreground="{Binding PlayerColor}"/>
                                                                                                            <Border Grid.Column="1" BorderBrush="{Binding EncounterColor}" BorderThickness="1" Padding="3,1" Margin="6,4" HorizontalAlignment="Center">
                                                                                                                <TextBlock Text="{Binding EncounterLabel}" Foreground="{Binding EncounterColor}" FontFamily="Consolas" FontSize="8"/>
                                                                                                            </Border>
                                                                                                            <TextBlock Grid.Column="2" Text="{Binding Kills}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource TextBrush}"/>
                                                                                                            <TextBlock Grid.Column="3" Text="{Binding Deaths}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource TextBrush}"/>
                                                                                                            <TextBlock Grid.Column="4" Text="{Binding Assists}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource TextBrush}"/>
                                                                                                        </Grid>
                                                                                                    </DataTemplate>
                                                                                                </ItemsControl.ItemTemplate>
                                                                                            </ItemsControl>
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </Border>
                                                                </Expander>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>

                                            <Grid x:Name="StatsSessionPlayersPanel" Grid.Row="1" Visibility="Collapsed">
                                                <ListView x:Name="StatsSessionPlayersList" MaxHeight="420" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                    <ListView.View>
                                                        <GridView>
                                                            <GridViewColumn Header="GAMERTAG" Width="220"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Gamertag}" FontFamily="Consolas" Foreground="{DynamicResource TextBrush}" Padding="6,4"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                                            <GridViewColumn Header="LAST SEEN" Width="125" DisplayMemberBinding="{Binding LastSeen}"/>
                                                            <GridViewColumn Header="ENCOUNTER" Width="120"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="6,0"><Ellipse Width="7" Height="7" Fill="{Binding EncounterColor}" Margin="0,0,7,0"/><TextBlock Text="{Binding Encounter}" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                                            <GridViewColumn Header="MATCHES" Width="90" DisplayMemberBinding="{Binding Matches}"/>
                                                            <GridViewColumn Header="W–L" Width="90" DisplayMemberBinding="{Binding Record}"/>
                                                            <GridViewColumn Header="AVG K/D" Width="100"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding AverageKD}" Foreground="{Binding KdColor}" FontFamily="Consolas" FontWeight="SemiBold" Padding="6,4"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                                        </GridView>
                                                    </ListView.View>
                                                </ListView>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- ── Row 6: Status bar ──────────────────────────────────────── -->
                        <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0" Padding="14,6">
                            <TextBlock x:Name="StatsStatusLabel"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="Ready — configure your gamertag on Dashboard, then sync or scan."/>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ═══ POPULATION ═══ -->
                <TabItem x:Name="PopulationSection" Header="⌁  POPULATION" Style="{StaticResource DarkTabItem}">
                    <TabItem.Resources>
                        <Style x:Key="PopulationActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="MinWidth" Value="100"/>
                            <Setter Property="Padding" Value="12,4"/>
                            <Setter Property="Margin" Value="0,0,6,6"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="ListView">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Style>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Padding" Value="8,5"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="PopulationRowBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1">
                                            <GridViewRowPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="PopulationRowBorder" Property="Background" Value="{DynamicResource StatsHoverRowBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="PopulationRowBorder" Property="Background" Value="#102A36"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabItem.Resources>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="280"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="MATCHMAKING POPULATION" FontFamily="Consolas" FontSize="12"
                                           FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="1. Start the MCC Data Proxy below. Allow the Administrator prompt if shown."
                                           TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="2. Launch MCC, sign in, and open Multiplayer. If MCC was already open, restart it after starting the proxy."
                                           TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="3. Start searching for a multiplayer game, then cancel the search and return to the lobby. This captures population authorization."
                                           TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="4. Wait up to one minute or click Refresh. Select a queue below to show its graph; more points appear each minute."
                                           TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource TextBrush}"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="PopulationStartProxyButton" Content="START PROXY"
                                            Style="{StaticResource PopulationActionButton}" Click="PopulationStartProxy_Click"/>
                                    <Button Content="REFRESH" Style="{StaticResource PopulationActionButton}" Click="StatsPopulationRefresh_Click"/>
                                    <Button Content="OPEN GRAPH" Style="{StaticResource PopulationActionButton}" Click="StatsPopulationGraph_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="StatsPopulationStatusLabel" Text="Start the proxy, launch MCC, then start matchmaking and return to the lobby to authorize population data."
                                           TextWrapping="Wrap" FontFamily="Consolas" FontSize="10"
                                           Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Margin="14,12,14,10" Padding="12"
                                Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <ToggleButton x:Name="PopulationRange15Button" Content="15M" Tag="15" Style="{StaticResource StatsToggleBtn}" Padding="8,4" Margin="0,0,4,0" Click="PopulationRangeButton_Click"/>
                                        <ToggleButton x:Name="PopulationRange30Button" Content="30M" Tag="30" Style="{StaticResource StatsToggleBtn}" Padding="8,4" Margin="0,0,4,0" Click="PopulationRangeButton_Click"/>
                                        <ToggleButton x:Name="PopulationRange60Button" Content="1H" Tag="60" IsChecked="True" Style="{StaticResource StatsToggleBtn}" Padding="8,4" Margin="0,0,4,0" Click="PopulationRangeButton_Click"/>
                                        <ToggleButton x:Name="PopulationRange180Button" Content="3H" Tag="180" Style="{StaticResource StatsToggleBtn}" Padding="8,4" Click="PopulationRangeButton_Click"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="StatsPopulationChartTitle" Text="POPULATION HISTORY · SOCIAL 4S" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="Select any queue in the table below to replace this line." FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <local:PopulationHistoryChart x:Name="StatsPopulationChart" Grid.Row="1"/>
                                <TextBlock x:Name="StatsPopulationChartSummary" Grid.Row="2" Text="LAST 60 MINUTES · WAITING FOR SAMPLES" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
                            </Grid>
                        </Border>

                        <ListView x:Name="StatsPopulationList" Grid.Row="2"
                                  SelectionChanged="StatsPopulationSelectionChanged"
                                  ItemsSource="{Binding}"
                                  SelectionMode="Single"

                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="330" DisplayMemberBinding="{Binding DisplayName}">
                                        <GridViewColumn.Header><GridViewColumnHeader Content="QUEUE" Tag="DisplayName" Click="StatsPopulationHeader_Click"/></GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="80" DisplayMemberBinding="{Binding Mode}">
                                        <GridViewColumn.Header><GridViewColumnHeader Content="MODE" Tag="Mode" Click="StatsPopulationHeader_Click"/></GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="80" DisplayMemberBinding="{Binding Size}">
                                        <GridViewColumn.Header><GridViewColumnHeader Content="SIZE" Tag="Size" Click="StatsPopulationHeader_Click"/></GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="100" DisplayMemberBinding="{Binding PopulationDisplay}">
                                        <GridViewColumn.Header><GridViewColumnHeader Content="SEARCHING" Tag="Population" Click="StatsPopulationHeader_Click"/></GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="100" DisplayMemberBinding="{Binding WaitDisplay}">
                                        <GridViewColumn.Header><GridViewColumnHeader Content="AVG WAIT" Tag="WaitSeconds" Click="StatsPopulationHeader_Click"/></GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="100" DisplayMemberBinding="{Binding Activity}">
                                        <GridViewColumn.Header><GridViewColumnHeader Content="ACTIVITY" Tag="Activity" Click="StatsPopulationHeader_Click"/></GridViewColumn.Header>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                Padding="14,6">
                            <TextBlock Text="Population and wait are shared across each hopper. Specific game and mode selections may take longer."
                                       FontFamily="Consolas" FontSize="9"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ═══ MATCH HISTORY ═══ -->
                <TabItem x:Name="MatchHistorySection" Header="▦  MATCH HISTORY" Style="{StaticResource DarkTabItem}">
                    <ContentControl x:Name="MatchHistoryHost">
                        <TextBlock Text="Match History loads when this tab is opened."
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontFamily="Consolas"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </ContentControl>
                </TabItem>

                <!-- ═══ BAN CHECKER ═══ -->
                <TabItem x:Name="BanCheckerSection" Header="🔨  BAN CHECKER" Style="{StaticResource DarkTabItem}">
                    <ContentControl x:Name="BanCheckerHost">
                        <TextBlock Text="Ban Checker loads when this tab is opened."
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontFamily="Consolas"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </ContentControl>
                </TabItem>

                <!-- ═══ TAB 4: THEATER ═══ -->
                <TabItem x:Name="TheaterSection" Header="🎬  THEATER" Style="{StaticResource DarkTabItem}">
                    <ContentControl x:Name="TheaterHost">
                        <TextBlock Text="Theater loads when this tab is opened."
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontFamily="Consolas"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </ContentControl>
                </TabItem>

                <!-- ═══ TAB 5: PLAYLISTS ═══ -->
                <TabItem x:Name="DownpatchSection" Header="DOWNPATCHING" Style="{StaticResource DarkTabItem}">
                    <ContentControl x:Name="DownpatchHost"/>
                </TabItem>

                <TabItem x:Name="PlaylistsSection" Header="🗂  PLAYLIST INFO" Style="{StaticResource DarkTabItem}">

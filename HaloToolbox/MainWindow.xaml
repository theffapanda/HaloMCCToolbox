                            </StackPanel>
                        </Border>
                    </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- ═══ TAB 8: LOG ═══ -->
                <TabItem x:Name="LogSection" Header="📋  LOG" Style="{StaticResource DarkTabItem}">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2">
                            <TextBox x:Name="TxtLog"
                                     IsUndoEnabled="False"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextBrush}"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Padding="14,10"
                                     IsReadOnly="True"
                                     IsReadOnlyCaretVisible="True"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     TextWrapping="NoWrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Border>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,0,0">

05 1797.87,2727.3 1750.05,2757.72C1702.23,2788.14 1603.94,2850.03 1546.99,2945.12C1490.04,3040.21 1485.99,3133.64 1502.79,3176.68C1512.45,3201.42 1510.8,3209.21 1497.47,3217.69L1448.35,3248.94L1466.96,3278.19L1516.32,3246.79C1527.92,3239.41 1537.82,3240.24 1551.01,3252.81C1574.11,3274.81 1633.64,3314.79 1713.37,3320.37C1810.53,3327.17 1906.96,3297.57 1995.42,3241.29C2033.38,3217.14 2042.76,3209.83 2042.76,3209.83L2036.96,3180.65C2036.96,3180.65 2084.43,3148.83 2114.98,3120.22C2145.54,3091.6 2160.61,3071.59 2177.75,3029.84C2162.4,3024.86 2125.48,3010.68 2125.48,3010.68C2125.48,3010.68 2090.39,3078.64 1980.42,3148.6C1843.33,3235.81 1679.26,3240.48 1622.76,3151.67Z</Geometry>
        <MatrixTransform x:Key="HaloToolboxLogoTransform" Matrix="-0.743675,0.473109,0.473109,0.743675,469.479,-2554.87"/>
        <!-- Scanline brush -->
        <DrawingBrush x:Key="ScanlineBrush" TileMode="Tile"
                      Viewport="0,0,1,4" ViewportUnits="Absolute"
                      Viewbox="0,0,1,4"   ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#08000000">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,2,1,2"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <!-- Basic/Advanced mode converters -->
        <local:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- ComboBox style for dark mode -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Content="{TemplateBinding Content}" Margin="8,4" VerticalAlignment="Center" HorizontalAlignment="Left" TextBlock.Foreground="{DynamicResource TextBrush}"/>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" Margin="0">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem style for proper text color in dark mode -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <!-- Shared toggle style used by Population and Stats. -->
        <Style x:Key="StatsToggleBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StatsMyRowBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#39FF14"/>
                                <Setter Property="Foreground" Value="#39FF14"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00C8FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Lightweight task navigation. The existing TabControl remains the
             content/lifecycle owner; these radios only select its pages. -->
        <Style x:Key="SidebarNavButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#0D1820"/>
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarSectionLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Margin" Value="8,14,0,6"/>
        </Style>

        <Style x:Key="SidebarStatusLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8499AC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarStatusActionButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="FontSize" Value="9"/>
        </Style>

        <Style x:Key="HomeTaskButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TaskBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TaskBorder" Property="Background" Value="#0D1820"/>
                                <Setter TargetName="TaskBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TaskBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Outer chrome -->
    <Border Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            ClipToBounds="True">

        <!-- Scanlines overlay -->
        <Grid x:Name="MainRootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- ══ TITLE BAR ══ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="14,0">
                        <Border Width="34"
                                Height="34"
                                Margin="0,0,10,0"
                                CornerRadius="8"
                                BorderBrush="#3000C8FF"
                                BorderThickness="1"
                                Background="#120C1218">
                            <Viewbox Width="24" Height="24" Stretch="Uniform">
                                <Canvas Width="1080" Height="1080">
                                    <Path Data="{StaticResource HaloToolboxLogoGeometry}"
                                          RenderTransform="{StaticResource HaloToolboxLogoTransform}"
                                          Fill="White"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Visibility="Collapsed" Text="🐼"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock FontFamily="Consolas"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center">
                            <Run Foreground="{DynamicResource TextBrush}" Text="HALO MCC"/>
                            <Run Foreground="{DynamicResource AccentBrush}" Text=" TOOLBOX"/>
                            <Run Foreground="{DynamicResource MutedBrush}" Text="  ·  THE FFA PANDA"/>
                        </TextBlock>
                        <Border Margin="12,0,0,0"
                                Padding="8,3"
                                Background="#101C26"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="TxtMccEditionBadge"
                                       Text="MCC: CHECKING"
                                       FontFamily="Consolas"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Window controls -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">

                        <!-- Main-section visibility settings -->
                        <Button x:Name="SectionSettingsBtn"
                                Content="⚙"
                                Width="36" Height="28"
                                FontSize="15"
                                ToolTip="Choose visible sections"
                                Click="SectionSettingsBtn_Click"
                                Background="Transparent"
                                Foreground="{DynamicResource MutedBrush}"
                                BorderThickness="0"
                                Cursor="Hand"/>
                        <Popup x:Name="SectionSettingsPopup"
                               PlacementTarget="{Binding ElementName=SectionSettingsBtn}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="14"
                                    MinWidth="210">
                                <Border.Resources>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Style>
                                </Border.Resources>
                                <StackPanel>
                                    <TextBlock Text="VISIBLE SECTIONS" FontFamily="Consolas"
                                               FontWeight="Bold" FontSize="11"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,0,0,10"/>
                                    <CheckBox x:Name="ShowHomeSection" Content="Dashboard" IsChecked="True" IsEnabled="False" Margin="0,3"/>
                                    <CheckBox x:Name="ShowMapsSection" Content="Halo 3 Maps" Tag="Maps" Margin="0,3" Click="SectionVisibility_Click"/>
                                    <CheckBox x:Name="ShowH3ModsSection" Content="Mods" Tag="H3Mods" Margin="0,3" Click="SectionVisibility_Click"/>
                                    <CheckBox x:Name="ShowPlaylistsSection" Content="Playlist Info" Tag="Playlists" Margin="0,3" Click="SectionVisibility_Click"/>
                                    <CheckBox x:Name="ShowVpnSection" Content="MCC VPN" Tag="Vpn" Margin="0,3" Click="SectionVisibility_Click"/>
                                    <CheckBox x:Name="ShowOverlaysSection" Content="Overlays" Tag="Overlays" Margin="0,3" Click="SectionVisibility_Click"/>
                                    <CheckBox x:Name="ShowFirewallSection" Content="Firewall Fix" Tag="Firewall" Margin="0,3" Click="SectionVisibility_Click"/>
                                    <CheckBox x:Name="ShowStatsSection" Content="Stats" Tag="Stats" Margin="0,3" Click="SectionVisibility_Click"/>
                                    <CheckBox x:Name="ShowPopulationSection" Content="Population" Tag="Population" Margin="0,3" Click="SectionVisibility_Click"/>
                                    <CheckBox x:Name="ShowMatchHistorySection" Content="Match History" Tag="MatchHistory" Margin="0,3" Click="SectionVisibility_Click"/>
                                    <CheckBox x:Name="ShowBanCheckerSection" Content="Ban Checker" Tag="BanChecker" Margin="0,3" Click="SectionVisibility_Click"/>
                                    <CheckBox x:Name="ShowTheaterSection" Content="Theater" Tag="Theater" Margin="0,3" Click="SectionVisibility_Click"/>
                                    <CheckBox x:Name="ShowDownpatchSection" Content="Downpatching" Tag="Downpatch" Margin="0,3" Click="SectionVisibility_Click"/>
                                    <CheckBox x:Name="ShowReportSection" Content="Report" Tag="Report" Margin="0,3" Click="SectionVisibility_Click"/>
                                    <CheckBox x:Name="ShowFixesSection" Content="Fixes" Tag="Fixes" Margin="0,3" Click="SectionVisibility_Click"/>
                                    <CheckBox x:Name="ShowLogSection" Content="Log" Tag="Log" Margin="0,3" Click="SectionVisibility_Click"/>
                                    <CheckBox x:Name="ShowAboutSection" Content="About" IsChecked="True" IsEnabled="False" Margin="0,3"/>
                                    <Button x:Name="ToggleAllSectionsBtn" Content="HIDE ALL" Margin="0,12,0,0" Padding="8,4"
                                            FontFamily="Consolas" FontSize="10"
                                            Click="ToggleAllSections_Click"/>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Theme toggle -->
                        <Button x:Name="ThemeToggleBtn"
                                Width="36" Height="28"
                                FontSize="14"
                                ToolTip="Toggle light / dark mode"
                                Click="ThemeToggleBtn_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="MinBtn"
                                Content="─"
                                Width="36" Height="28"
                                FontSize="14"
                                Foreground="{DynamicResource MutedBrush}"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="MinBtn_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="MaxBtn"
                                Content="□"
                                Width="36" Height="28"
                                FontSize="13"
                                Foreground="{DynamicResource MutedBrush}"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Maximize"
                                Click="MaxBtn_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="CloseBtn"
                                Content="✕"
                                Width="36" Height="28"
                                FontSize="12"
                                Cursor="Hand"
                                Click="CloseBtn_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>

                                    <TextBlock Text="&#x21A7;" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="DOWNPATCHING" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="SidebarReportButton"

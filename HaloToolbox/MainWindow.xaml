                                    <Border x:Name="MatchmakingWaitPreviewCard" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="11" Margin="6,0,0,6">

                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,9"/>

                                    <Button Tag="Maps" Style="{StaticResource HomeTaskButton}"
                                            Click="ToolsHomeTask_Click" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}">
                                                    <Run Foreground="{DynamicResource AccentBrush}" Text="🗺  "/><Run Text="MANAGE HALO 3 MAPS"/>
                                                </TextBlock>
                                                <TextBlock Text="Choose which multiplayer maps MCC should load."
                                                           FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="OPEN  ›" FontFamily="Consolas" FontSize="10"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </Grid>
                                    </Button>

                                    <Button Tag="Vpn" Style="{StaticResource HomeTaskButton}"
                                            Visibility="{Binding Visibility, ElementName=VpnSection}"
                                            Click="ToolsHomeTask_Click" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}">
                                                    <Run Foreground="{DynamicResource AccentBrush}" Text="◈  "/><Run Text="CONNECT MCC VPN"/>
                                                </TextBlock>
                                                <TextBlock Text="Route MCC through NordVPN while every other app stays direct."
                                                           FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="OPEN  ›" FontFamily="Consolas" FontSize="10"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </Grid>
                                    </Button>

                                    <Button Tag="BanChecker" Style="{StaticResource HomeTaskButton}"
                                            Click="ToolsHomeTask_Click" Margin="0,0,0,8">

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▦" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="MATCH HISTORY" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="SidebarBanCheckerButton"
                                         GroupName="MainNavigation" Tag="BanChecker"
                                         Visibility="{Binding Visibility, ElementName=BanCheckerSection}"

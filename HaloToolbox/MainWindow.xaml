                                    <TextBlock Text="▤" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="PLAYLIST INFO" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="NETWORK" Style="{StaticResource SidebarSectionLabel}"/>
                            <RadioButton x:Name="SidebarVpnButton"
                                         GroupName="MainNavigation" Tag="Vpn"
                                         Visibility="{Binding Visibility, ElementName=VpnSection}"
                                         Style="{StaticResource SidebarNavButton}"

<Window x:Class="HaloToolbox.PopulationHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Resources/halo_toolbox_whiteicon.ico"
        Title="Population History" Width="900" Height="560"
        MinWidth="640" MinHeight="400" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Consolas">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="MATCHMAKING POPULATION" FontSize="15"
                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button DockPanel.Dock="Right" Content="EXPORT CSV" Padding="10,5"
                    Margin="12,0,0,0" Click="ExportCsv_Click"/>
            <ComboBox x:Name="HopperBox" MinWidth="330" HorizontalAlignment="Left"
                      SelectionChanged="HopperBox_SelectionChanged"/>
        </DockPanel>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <local:PopulationHistoryChart x:Name="Chart"
                xmlns:local="clr-namespace:HaloToolbox" Margin="10"/>
        </Border>
        <TextBlock x:Name="SummaryLabel" Grid.Row="2" Margin="0,10,0,0"
                   Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
    </Grid>
</Window>

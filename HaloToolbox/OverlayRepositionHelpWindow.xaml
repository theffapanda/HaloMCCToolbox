<Window x:Class="HaloToolbox.OverlayRepositionHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay Repositioning"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Consolas"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ShortcutBadge" TargetType="Border">
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#CC06384A"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    Padding="18,13"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="OVERLAY REPOSITIONING"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="15"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Arrange the in-game overlay windows"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="10"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Content="X"
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Foreground="{DynamicResource AccentBrush}"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand"
                            ToolTip="Dismiss"
                            Click="DismissButton_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="22,20,22,18">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ShortcutBadge}">
                        <TextBlock Text="DRAG"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="Bold"
                                   TextAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="Move an overlay. Snapped overlays move together."
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ShortcutBadge}">
                        <TextBlock Text="SHIFT + DRAG"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="Bold"
                                   TextAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="Detach and move only the selected overlay."
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ShortcutBadge}">
                        <TextBlock Text="CORNER GRIP"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="Bold"
                                   TextAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="Drag the lower-right corner to resize one overlay."
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </Grid>

            </StackPanel>

            <Border Grid.Row="2"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="18,12">
                <Grid>
                    <TextBlock Text="Click FINISH in Halo MCC Toolbox when done."
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="10"
                               VerticalAlignment="Center"/>
                    <Button Content="GOT IT"
                            HorizontalAlignment="Right"
                            Padding="16,7"
                            Style="{StaticResource PrimaryButton}"
                            Click="DismissButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

<UserControl x:Class="HaloToolbox.MatchHistory"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}"
             Foreground="{DynamicResource TextBrush}"
             FontFamily="Consolas">
    <UserControl.Resources>
        <Style x:Key="SummaryCaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SummaryValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <GridViewRowPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StatsHoverRowBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Won}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MatchWinRowBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Won}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource MatchLossRowBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,22,0" VerticalAlignment="Center">
                    <TextBlock Text="MATCH HISTORY"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Load up to the latest 100 available games."
                               FontSize="10" Foreground="{DynamicResource MutedBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <TextBox x:Name="GamertagBox"
                         Grid.Column="1"
                         Style="{StaticResource DarkTextBox}"
                         MinWidth="220"
                         MaxWidth="480"
                         HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Center"
                         KeyDown="GamertagBox_KeyDown"
                         ToolTip="Enter an Xbox gamertag"/>
                <Button x:Name="LoadButton"
                        Grid.Column="2"
                        Content="LOAD GAMES"
                        Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0"
                        Padding="14,7"
                        Click="LoadButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <UniformGrid Columns="8">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="MATCHES" Style="{StaticResource SummaryCaptionStyle}"/>
                    <TextBlock x:Name="MatchesLabel" Text="—" Style="{StaticResource SummaryValueStyle}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="WIN RATE" Style="{StaticResource SummaryCaptionStyle}"/>
                    <TextBlock x:Name="WinRateLabel" Text="—" Style="{StaticResource SummaryValueStyle}" Foreground="{DynamicResource GreenBrush}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="K/D" Style="{StaticResource SummaryCaptionStyle}"/>
                    <TextBlock x:Name="KdLabel" Text="—" Style="{StaticResource SummaryValueStyle}" Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="TOTAL KILLS" Style="{StaticResource SummaryCaptionStyle}"/>
                    <TextBlock x:Name="TotalKillsLabel" Text="—" Style="{StaticResource SummaryValueStyle}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="TOTAL DEATHS" Style="{StaticResource SummaryCaptionStyle}"/>
                    <TextBlock x:Name="TotalDeathsLabel" Text="—" Style="{StaticResource SummaryValueStyle}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="AVG KILLS" Style="{StaticResource SummaryCaptionStyle}"/>
                    <TextBlock x:Name="AvgKillsLabel" Text="—" Style="{StaticResource SummaryValueStyle}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="AVG DEATHS" Style="{StaticResource SummaryCaptionStyle}"/>
                    <TextBlock x:Name="AvgDeathsLabel" Text="—" Style="{StaticResource SummaryValueStyle}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="AVG SCORE" Style="{StaticResource SummaryCaptionStyle}"/>
                    <TextBlock x:Name="AvgScoreLabel" Text="—" Style="{StaticResource SummaryValueStyle}"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <ListView x:Name="MatchList" Grid.Row="2">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="DATE" Width="148">
                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Date}" Foreground="{DynamicResource MutedBrush}" Padding="6,5" FontSize="11"/></DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="GAME" Width="58">
                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Game}" Foreground="{DynamicResource TextBrush}" Padding="6,5" FontSize="11"/></DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="TIME" Width="56">
                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Duration}" Foreground="{DynamicResource MutedBrush}" Padding="6,5" FontSize="11"/></DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="RESULT" Width="62">
                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Result}" Foreground="{Binding ResultColor}" FontWeight="SemiBold" Padding="6,5" FontSize="11"/></DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="K" Width="42">
                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Kills}" Foreground="{DynamicResource TextBrush}" Padding="6,5" HorizontalAlignment="Right" FontSize="11"/></DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="D" Width="42">
                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Deaths}" Foreground="{DynamicResource TextBrush}" Padding="6,5" HorizontalAlignment="Right" FontSize="11"/></DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="K/D" Width="58">
                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding KD}" Foreground="{Binding KdColor}" FontWeight="SemiBold" Padding="6,5" HorizontalAlignment="Right" FontSize="11"/></DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="ASSISTS" Width="64">
                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Assists}" Foreground="{DynamicResource MutedBrush}" Padding="6,5" HorizontalAlignment="Right" FontSize="11"/></DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="HS" Width="44">
                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Headshots}" Foreground="{DynamicResource MutedBrush}" Padding="6,5" HorizontalAlignment="Right" FontSize="11"/></DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="MEDALS" Width="64">
                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Medals}" Foreground="{DynamicResource MutedBrush}" Padding="6,5" HorizontalAlignment="Right" FontSize="11"/></DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="SCORE" Width="70">
                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Score}" Foreground="{DynamicResource TextBrush}" Padding="6,5" HorizontalAlignment="Right" FontSize="11"/></DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock x:Name="StatusText"
                       Text="Enter a gamertag to load match history."
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>

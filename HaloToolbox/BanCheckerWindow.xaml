<Window x:Class="HaloToolbox.BanCheckerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Resources/halo_toolbox_whiteicon.ico"
        Title="Ban Checker" Width="760" Height="620"
        MinWidth="620" MinHeight="480"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Consolas" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="CHECK MULTIPLE PLAYERS" Foreground="{DynamicResource AccentBrush}"
                       FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="Enter up to 15 gamertags or XUIDs, one per line. This does not use the gamertag in the Stats bar."
                       Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBox x:Name="TargetsBox" Grid.Row="1" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                 Padding="9" FontSize="13" Background="{DynamicResource SurfaceBrush}"
                 Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                 TextChanged="TargetsBox_TextChanged"/>

        <DockPanel Grid.Row="2" Margin="0,8,0,10">
            <TextBlock x:Name="CountText" Text="0 / 15" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Right" TextAlignment="Right"/>
        </DockPanel>

        <DataGrid x:Name="ResultsGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" RowBackground="Transparent"
                  AlternatingRowBackground="#0DFFFFFF">
            <DataGrid.Columns>
                <DataGridTextColumn Header="GAMERTAG / XUID" Binding="{Binding Target}" Width="2*"/>
                <DataGridTextColumn Header="RESULT" Binding="{Binding Result}" Width="*"/>
                <DataGridTextColumn Header="DETAILS" Binding="{Binding Details}" Width="3*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="CLOSE" Padding="14,6" Margin="0,0,8,0" Click="Close_Click"/>
            <Button x:Name="CheckButton" Content="CHECK PLAYERS" Style="{StaticResource PrimaryButton}"
                    Padding="14,6" Click="Check_Click"/>
        </StackPanel>
    </Grid>
</Window>

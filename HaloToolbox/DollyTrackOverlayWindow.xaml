<Window x:Class="HaloToolbox.DollyTrackOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dolly Track Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">
    <Grid IsHitTestVisible="False">
        <local:DollyTrackVisual xmlns:local="clr-namespace:HaloToolbox"
                                x:Name="TrackVisual"/>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\halo_toolbox_whiteicon.ico</ApplicationIcon>
    <AssemblyName>HaloMCCToolbox</AssemblyName>
    <RootNamespace>HaloToolbox</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Unobtanium.Web.Proxy" Version="0.1.5" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\playlist-rotations.csv"
                      LogicalName="HaloToolbox.Data.playlist-rotations.csv" />
    <EmbeddedResource Include="Native\ReachBloomHook.dll"
                      LogicalName="HaloToolbox.Native.ReachBloomHook.dll" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\halo_toolbox_whiteicon.ico" />
    <Resource Include="Resources\halo_toolbox_icon.png" />
    <Resource Include="Resources\Medals\*.png" />
  </ItemGroup>

  <PropertyGroup>
    <GenerateStandaloneOnReleaseBuild Condition="'$(GenerateStandaloneOnReleaseBuild)' == ''">true</GenerateStandaloneOnReleaseBuild>
    <StandaloneRuntimeIdentifier>win-x64</StandaloneRuntimeIdentifier>
    <StandalonePublishIntermediateDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)standalone-publish\$(Configuration)\'))</StandalonePublishIntermediateDir>
    <StandaloneOutputDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\bin\Standalone\'))</StandaloneOutputDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <UpToDateCheckOutput Include="$(StandaloneOutputDir)$(AssemblyName).exe" />
  </ItemGroup>

  <Target Name="BuildStandaloneExecutable"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release'
                     and '$(GenerateStandaloneOnReleaseBuild)' == 'true'
                     and '$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(StandalonePublishIntermediateDir)" />
    <MakeDir Directories="$(StandalonePublishIntermediateDir)" />

    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Publish"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(StandaloneRuntimeIdentifier);SelfContained=true;PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;EnableCompressionInSingleFile=true;PublishTrimmed=false;PublishReadyToRun=false;DebugType=None;DebugSymbols=false;PublishDir=$(StandalonePublishIntermediateDir);GenerateStandaloneOnReleaseBuild=false" />

    <Error Condition="!Exists('$(StandalonePublishIntermediateDir)$(AssemblyName).exe')"
           Text="Standalone publish did not produce $(AssemblyName).exe." />

    <MakeDir Directories="$(StandaloneOutputDir)" />
    <Copy SourceFiles="$(StandalonePublishIntermediateDir)$(AssemblyName).exe"
          DestinationFiles="$(StandaloneOutputDir)$(AssemblyName).exe" />
    <RemoveDir Directories="$(StandalonePublishIntermediateDir)" />

    <Message Importance="high"
             Text="Standalone executable: $(StandaloneOutputDir)$(AssemblyName).exe" />
  </Target>

</Project>
